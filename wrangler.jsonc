
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-artfive-railway-assistant",
  "main": "./worker.js",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-artfive-database",
      "database_id": "19ac26a4-4cdb-452f-915d-2aed755ab984"
    }
  ]
}
