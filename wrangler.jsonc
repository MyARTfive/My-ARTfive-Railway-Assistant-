{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-artfive-railway-assistant",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-artfive-railway-db",
      "database_id": "9ccc1d01-a125-4430-8ad4-47eef289a85e"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "4b370760-55cf-43cb-87f3-c3ab97fe94f1"
      }
    ]
  },
  "env": {
    "preview": {
      "name": "my-artfive-railway-assistant-preview",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "my-artfive-railway-db-preview",
          "database_id": "4b370760-55cf-43cb-87f3-c3ab97fe94f1"
        }
      ]
    }
  },
  "observability": {
    "enabled": true
  }
}
