{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-artfive-railway-assistant",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-artfive-railway-db",
      "database_id": "9ccc1d01-a125-4430-8ad4-47eef289a85e"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "19ac26a4-4cdb-452f-915d-2aed755ab984"
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
